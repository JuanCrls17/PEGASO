{
  "name": "PEGASO",
  // El visor es HTML, CSS y JS sin compilar: basta con servir la carpeta.
  // Python sigue aquí porque tools/generar_valores.py rehace data/valores
  // y data/indices a partir de las mallas NetCDF; solo usa la librería
  // estándar, así que no hay nada que instalar.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "index.html"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postAttachCommand": {
    "server": "python3 -m http.server 8000"
  },
  "portsAttributes": {
    "8000": {
      "label": "PEGASO",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8000
  ]
}
